# ─── DATABASE ─────────────────────────────────────────
DATABASE_URL="postgresql://cafeflow:cafeflow_dev@localhost:5433/cafeflow?schema=public"

# ─── REDIS ────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET="change_this_super_secret_key_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change_this_refresh_secret_key_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── APP ──────────────────────────────────────────────
NODE_ENV="development"
API_PORT=3001
API_PREFIX="api/v1"
# Orígenes del frontend separados por comas. Fuera de producción también se
# acepta http://localhost en cualquier puerto.
CORS_ORIGIN="http://localhost:3000"
# Valor de "trust proxy" de Express. Dejar vacío salvo que un proxy propio
# (nginx, Cloudflare) delante de Next SOBRESCRIBA X-Forwarded-For; Next solo
# lo reenvía, así que sin ese proxy el cliente podría falsificar su IP.
# Ejemplo con nginx en la misma máquina que Next y la API: TRUST_PROXY="loopback"
TRUST_PROXY=""
# URL pública del frontend; se usa para armar los enlaces de los correos.
APP_URL="http://localhost:3000"

# ─── CORREO (SMTP) ────────────────────────────────────
# Cualquier proveedor SMTP sirve (Brevo, SES, Resend, Gmail con app password).
# Si SMTP_HOST está vacío y NODE_ENV no es production, los correos se imprimen
# en la consola de la API en lugar de enviarse.
SMTP_HOST=""
SMTP_PORT=587
# true solo para el puerto 465 (TLS implícito); 587 usa STARTTLS.
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CafeFlow <no-reply@cafeflow.app>"

# ─── FRONTEND ─────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
